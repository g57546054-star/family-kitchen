{
  "description": "家常厨房 · 原生小程序，阶段2B可选家庭共享",
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "appid": "wxb104c5308c2ebb48",
  "projectname": "family-kitchen-native",
  "libVersion": "latest",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./miniprogram/package.json",
        "miniprogramNpmDistDir": "./miniprogram/"
      }
    ]
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      }
    ]
  },
  "cloudfunctionRoot": "cloudfunctions/"
}
