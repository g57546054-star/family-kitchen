{
  "description": "家常厨房 · 微信原生小程序（阶段 2A，本地存储）",
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "family-kitchen-native",
  "libVersion": "latest",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./miniprogram/package.json",
        "miniprogramNpmDistDir": "./miniprogram/"
      }
    ]
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "scripts" },
      { "type": "folder", "value": "docs" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "package-lock.json" }
    ]
  }
}
