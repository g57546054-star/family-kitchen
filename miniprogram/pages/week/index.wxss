.week-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx;
  border: 1rpx solid #e1e7d8;
  border-radius: 16rpx;
  background: #fff;
  font-size: 23rpx;
  color: #6a7f5c;
}
.week-status {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}
.week-count {
  flex-shrink: 0;
  white-space: nowrap;
}
.week-status-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.week-status-actions > t-button {
  flex-shrink: 0;
}
.day-card {
  margin-bottom: 28rpx;
  overflow: hidden;
}
.day-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f0f3e9;
  padding: 26rpx;
  font-size: 30rpx;
  color: #5f7751;
  font-weight: 600;
}
.day-heading.today {
  border-left: 8rpx solid #315c45;
  padding-left: 18rpx;
  background: #e8efdd;
}
.meal-slot {
  padding: 16rpx 26rpx 28rpx;
  border-bottom: 1rpx dashed #e2e8da;
}
.meal-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8c9a7d;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}
.planned-dish {
  padding: 12rpx 22rpx 24rpx;
  background: #f3f6ec;
  border-radius: 14rpx;
  margin-top: 18rpx;
}
.planned-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 29rpx;
}
.planned-heading > text {
  flex: 1;
}
.serving-control {
  display: flex;
  align-items: center;
  gap: 25rpx;
  font-size: 24rpx;
  color: #839573;
}
